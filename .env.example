# Development-only example. Replace all secrets before any deployment.
DJANGO_SECRET_KEY=change-this-development-key-before-deployment-0ab1c2d3e4f5g6h7
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY=false
