# Development-only example. Replace all secrets before any deployment.
DJANGO_SECRET_KEY=change-this-development-key-before-deployment-0ab1c2d3e4f5g6h7
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY=false
DJANGO_ENABLE_ADMIN=false
RETENTION_CLEANUP_ENABLED=false
RETENTION_EVIDENCE_DAYS=30
RETENTION_REPORT_DAYS=90
POSTGRES_DB=incidentforge
POSTGRES_USER=incidentforge
POSTGRES_PASSWORD=dev-only-change-this-password
DATABASE_URL=postgresql://incidentforge:dev-only-change-this-password@postgres:5432/incidentforge
REDIS_URL=redis://redis:6379/0
INTERNAL_API_ORIGIN=http://api:8000

# Interchangeable AI provider credentials are configured on the backend only.
AI_PROVIDER_TIMEOUT_SECONDS=16
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
